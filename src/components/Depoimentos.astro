<script>
  // Carrossel de depoimentos
  document.addEventListener('DOMContentLoaded', () => {
    const slider = document.getElementById('depoimentos-slider');
    const cards = slider?.querySelectorAll('.depoimento-card');
    const dotsContainer = document.querySelector('.depoimentos-dots');
    const prevBtn = document.querySelector('.prev-btn');
    const nextBtn = document.querySelector('.next-btn');
    
    if (!slider || !cards || !dotsContainer || !prevBtn || !nextBtn) return;
    
    let currentIndex = 0;
    let autoplayInterval;
    const totalCards = cards.length;
    
    // Criar os dots de navegação
    for (let i = 0; i < totalCards; i++) {
      const dot = document.createElement('button');
      dot.classList.add('dot');
      dot.setAttribute('aria-label', `Ir para depoimento ${i + 1}`);
      if (i === 0) dot.classList.add('active');
      dot.addEventListener('click', () => goToSlide(i));
      dotsContainer.appendChild(dot);
    }
    
    const dots = document.querySelectorAll('.dot');
    
    // Iniciar o autoplay
    startAutoplay();
    
    // Função para iniciar o autoplay
    function startAutoplay() {
      stopAutoplay(); // Primeiro para qualquer autoplay existente
      autoplayInterval = setInterval(() => {
        goToSlide((currentIndex + 1) % totalCards);
      }, 5000);
    }
    
    // Função para parar o autoplay
    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
      }
    }
    
    // Ir para um slide específico
    function goToSlide(index) {
      if (index < 0 || index >= totalCards) return;
      
      currentIndex = index;
      updateSlider();
      updateDots();
    }
    
    // Atualizar a posição do slider
    function updateSlider() {
      const cardWidth = slider.offsetWidth;
      slider.style.transform = `translateX(-${currentIndex * cardWidth}px)`;
    }
    
    // Atualizar os dots de navegação
    function updateDots() {
      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === currentIndex);
      });
    }
    
    // Event listeners para os botões de navegação
    prevBtn.addEventListener('click', () => {
      goToSlide((currentIndex - 1 + totalCards) % totalCards);
      resetAutoplay();
    });
    
    nextBtn.addEventListener('click', () => {
      goToSlide((currentIndex + 1) % totalCards);
      resetAutoplay();
    });
    
    // Parar autoplay no hover
    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);
    
    // Reiniciar autoplay após interação do usuário
    function resetAutoplay() {
      stopAutoplay();
      startAutoplay();
    }
    
    // Lidar com redimensionamento da janela
    window.addEventListener('resize', () => {
      updateSlider();
    });
    
    // Touch events para dispositivos móveis
    let touchStartX = 0;
    let touchEndX = 0;
    
    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoplay();
    }, { passive: true });
    
    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
      startAutoplay();
    }, { passive: true });
    
    function handleSwipe() {
      if (touchStartX - touchEndX > 50) {
        // Deslize para a esquerda (próximo)
        goToSlide((currentIndex + 1) % totalCards);
      } else if (touchEndX - touchStartX > 50) {
        // Deslize para a direita (anterior)
        goToSlide((currentIndex - 1 + totalCards) % totalCards);
      }
    }
  });
</script>

