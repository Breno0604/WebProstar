<script>
  // Atualizar o ano no copyright
  document.getElementById('ano-atual').textContent = new Date().getFullYear().toString();
  
  // Botão voltar ao topo
  const btnVoltarTopo = document.getElementById('voltar-topo');
  
  if (btnVoltarTopo) {
    // Mostrar/esconder botão conforme rolagem
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        btnVoltarTopo.classList.add('ativo');
      } else {
        btnVoltarTopo.classList.remove('ativo');
      }
    });
    
    // Scroll suave ao topo
    btnVoltarTopo.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
  
  // Simulação de inscrição na newsletter
  const newsletterForm = document.querySelector('.newsletter-form');
  
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = newsletterForm.querySelector('input[type="email"]');
      
      if (emailInput.value) {
        // Aqui seria a integração com o serviço de newsletter
        alert('E-mail cadastrado com sucesso! Obrigado por se inscrever.');
        emailInput.value = '';
      }
    });
  }
</script>

