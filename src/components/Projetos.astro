<script>
  // Filtros de projetos
  const filtros = document.querySelectorAll('.filtro-btn');
  const projetos = document.querySelectorAll('.projeto-card');
  
  filtros.forEach(filtro => {
    filtro.addEventListener('click', () => {
      // Remove classe ativa de todos os filtros
      filtros.forEach(f => f.classList.remove('active'));
      // Adiciona classe ativa ao filtro clicado
      filtro.classList.add('active');
      
      const categoria = filtro.getAttribute('data-filter');
      
      projetos.forEach(projeto => {
        // Exibe todos os projetos se o filtro for "todos"
        if (categoria === 'todos') {
          projeto.style.display = 'block';
          setTimeout(() => {
            projeto.style.opacity = '1';
            projeto.style.transform = 'scale(1)';
          }, 10);
        } else {
          // Exibe apenas os projetos da categoria selecionada
          if (projeto.getAttribute('data-categoria') === categoria) {
            projeto.style.display = 'block';
            setTimeout(() => {
              projeto.style.opacity = '1';
              projeto.style.transform = 'scale(1)';
            }, 10);
          } else {
            projeto.style.opacity = '0';
            projeto.style.transform = 'scale(0.8)';
            setTimeout(() => {
              projeto.style.display = 'none';
            }, 300);
          }
        }
      });
    });
  });
  
  // Animação de revelação ao rolar
  function revelarAoRolar() {
    const cards = document.querySelectorAll('.projeto-card');
    
    cards.forEach((card, index) => {
      const cardTop = card.getBoundingClientRect().top;
      const triggerBottom = window.innerHeight * 0.9;
      
      if (cardTop < triggerBottom) {
        card.style.animation = `fadeInUp 0.6s ease forwards ${index * 0.1}s`;
      }
    });
  }
  
  window.addEventListener('scroll', revelarAoRolar);
  window.addEventListener('load', revelarAoRolar);
</script>

