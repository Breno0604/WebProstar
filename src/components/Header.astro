<header id="header">
  <div class="container header-container">
    <a href="/" class="logo">WebProstar</a>
    
    <nav class="desktop-nav">
      <ul>
        <li><a href="#inicio">Início</a></li>
        <li><a href="#projetos">Projetos</a></li>
        <li><a href="#servicos">Serviços</a></li>
        <li><a href="#depoimentos">Depoimentos</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </nav>
    
    <a href="#contato" class="btn btn-primary">Solicitar Orçamento</a>
    
    <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
  
  <div class="mobile-nav">
    <nav>
      <ul>
        <li><a href="#inicio">Início</a></li>
        <li><a href="#projetos">Projetos</a></li>
        <li><a href="#servicos">Serviços</a></li>
        <li><a href="#depoimentos">Depoimentos</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="#contato" class="btn btn-primary">Solicitar Orçamento</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Manipulação do menu mobile
  const menuToggle = document.querySelector('.menu-toggle');
  const mobileNav = document.querySelector('.mobile-nav');
  const header = document.querySelector('#header');
  
  if (menuToggle && mobileNav) {
    menuToggle.addEventListener('click', () => {
      const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', !expanded);
      menuToggle.classList.toggle('active');
      mobileNav.classList.toggle('active');
      document.body.classList.toggle('menu-open');
    });
  }
  
  // Adicionar classe ao header quando scrollar
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  });
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 80px;
    z-index: 1000;
    transition: var(--transicao-padrao);
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
  }
  
  header.scrolled {
    background-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--sombra-suave);
  }
  
  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .logo {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: 24px;
    color: var(--cor-primaria);
  }
  
  .desktop-nav ul {
    display: flex;
    list-style: none;
    gap: 32px;
  }
  
  .desktop-nav a {
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    position: relative;
    transition: var(--transicao-padrao);
  }
  
  .desktop-nav a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--cor-secundaria);
    transition: var(--transicao-padrao);
  }
  
  .desktop-nav a:hover {
    color: var(--cor-secundaria);
  }
  
  .desktop-nav a:hover::after {
    width: 100%;
  }
  
  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    width: 30px;
    height: 22px;
    position: relative;
    z-index: 2000;
  }
  
  .menu-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--cor-primaria);
    position: absolute;
    left: 0;
    transition: var(--transicao-padrao);
  }
  
  .menu-toggle span:nth-child(1) {
    top: 0;
  }
  
  .menu-toggle span:nth-child(2) {
    top: 10px;
  }
  
  .menu-toggle span:nth-child(3) {
    top: 20px;
  }
  
  .menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg);
    top: 10px;
  }
  
  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }
  
  .menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg);
    top: 10px;
  }
  
  .mobile-nav {
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    height: 100vh;
    background-color: var(--cor-neutra);
    z-index: 1500;
    transition: var(--transicao-padrao);
    padding: 100px 2rem 2rem;
    opacity: 0;
  }
  
  .mobile-nav.active {
    right: 0;
    opacity: 1;
  }
  
  .mobile-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .mobile-nav a {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    display: block;
  }
  
  .mobile-nav .btn {
    display: inline-block;
    margin-top: 1.5rem;
  }
  
  body.menu-open {
    overflow: hidden;
  }
  
  @media (max-width: 1024px) {
    .desktop-nav, header .btn-primary {
      display: none;
    }
    
    .menu-toggle {
      display: block;
    }
  }
</style> 