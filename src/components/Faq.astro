<script>
  // Funcionalidade do accordion para FAQ
  const faqPerguntas = document.querySelectorAll('.faq-pergunta');
  
  faqPerguntas.forEach(pergunta => {
    pergunta.addEventListener('click', () => {
      // Obtém o estado atual do botão
      const isExpanded = pergunta.getAttribute('aria-expanded') === 'true';
      
      // Fecha todos os itens
      faqPerguntas.forEach(p => {
        p.setAttribute('aria-expanded', 'false');
        const resposta = p.nextElementSibling;
        resposta.style.maxHeight = null;
      });
      
      // Se o item clicado estava fechado, abre-o
      if (!isExpanded) {
        pergunta.setAttribute('aria-expanded', 'true');
        const resposta = pergunta.nextElementSibling;
        resposta.style.maxHeight = resposta.scrollHeight + 'px';
      }
    });
  });
  
  // Abre o primeiro item por padrão
  if (faqPerguntas.length > 0) {
    const primeiraPergunta = faqPerguntas[0];
    primeiraPergunta.setAttribute('aria-expanded', 'true');
    const primeiraResposta = primeiraPergunta.nextElementSibling;
    primeiraResposta.style.maxHeight = primeiraResposta.scrollHeight + 'px';
  }
</script>

