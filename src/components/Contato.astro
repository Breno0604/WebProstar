<script>
  // Simulação do envio do formulário
  const form = document.getElementById('contato-form');
  const formStatus = document.getElementById('form-status');
  
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = new FormData(form);
      const formValues = Object.fromEntries(formData.entries());
      
      // Simulação de envio (em um projeto real, aqui teria a integração com backend)
      formStatus.textContent = 'Enviando...';
      formStatus.classList.add('sending');
      
      // Simulação de resposta após 2 segundos
      setTimeout(() => {
        formStatus.textContent = 'Mensagem enviada com sucesso! Entraremos em contato em breve.';
        formStatus.classList.remove('sending');
        formStatus.classList.add('success');
        form.reset();
        
        // Limpa a mensagem após 5 segundos
        setTimeout(() => {
          formStatus.textContent = '';
          formStatus.classList.remove('success');
        }, 5000);
      }, 2000);
    });
  }
  
  // Máscara para o campo de telefone
  const telefoneInput = document.getElementById('telefone');
  
  if (telefoneInput) {
    telefoneInput.addEventListener('input', function (e) {
      let value = e.target.value.replace(/\D/g, '');
      
      if (value.length > 11) {
        value = value.substring(0, 11);
      }
      
      if (value.length > 0) {
        value = '(' + value;
      }
      if (value.length > 3) {
        value = value.substring(0, 3) + ') ' + value.substring(3);
      }
      if (value.length > 10) {
        value = value.substring(0, 10) + '-' + value.substring(10);
      }
      
      e.target.value = value;
    });
  }
</script>

